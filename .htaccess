RewriteEngine On

# No reescribir requests a /api/*.php — deben servirse tal cual
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^ - [L]

# Servir archivos y carpetas que existen tal cual (assets del build)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás cae a index.html (SPA routing de React Router)
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # index.html nunca debe quedar en caché (ni del navegador ni de SiteGround
  # Dynamic Cache): cada deploy genera archivos de assets con hash distinto,
  # y si index.html queda cacheado sigue apuntando a los archivos del deploy
  # anterior, causando errores (404 de rutas, JS desactualizado, etc.)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </FilesMatch>
  # Los assets sí llevan hash en el nombre (index-XXXXXXXX.js), así que se
  # pueden cachear agresivamente sin riesgo de servir una versión vieja.
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
