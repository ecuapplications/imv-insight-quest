VITE_API_URL=/api
# URL absoluta del sitio (sin slash final), usada para las etiquetas Open Graph
# en index.html. En un deploy de staging bajo una subcarpeta (ej. /alpha/),
# inclúyela: https://imvhealths.sg-host.com/alpha
VITE_SITE_URL=https://imvhealths.sg-host.com
# Clave pública VAPID para notificaciones push — debe coincidir con la clave
# pública configurada en api/config.php ('vapid.public_key').
VITE_VAPID_PUBLIC_KEY=CAMBIAR_CLAVE_PUBLICA_VAPID
